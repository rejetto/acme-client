{
    "name": "@rejetto/acme-client",
    "description": "Small ACME client tailored for HFS",
    "author": "nmorsman",
    "version": "5.4.0-hfs.0",
    "private": true,
    "main": "src/index.js",
    "types": "types/index.d.ts",
    "license": "MIT",
    "homepage": "https://github.com/publishlab/node-acme-client",
    "engines": {
        "node": ">= 19.6"
    },
    "files": [
        "src",
        "types"
    ],
    "dependencies": {
        "node-forge": "^1.3.1"
    },
    "devDependencies": {
        "@types/node": "^20.14.10",
        "chai": "^4.4.1",
        "chai-as-promised": "^7.1.2",
        "eslint": "^8.57.0",
        "eslint-config-airbnb-base": "^15.0.0",
        "eslint-plugin-import": "^2.29.1",
        "jsdoc-to-markdown": "^8.0.1",
        "mocha": "^10.6.0",
        "nock": "^13.5.4",
        "tsd": "^0.31.1"
    },
    "scripts": {
        "build-docs": "jsdoc2md src/client.js > docs/client.md && jsdoc2md src/crypto/index.js > docs/crypto.md && jsdoc2md src/crypto/forge.js > docs/forge.md",
        "lint": "eslint .",
        "lint-types": "tsd",
        "prepublishOnly": "npm run build-docs",
        "test": "node node_modules/mocha/bin/mocha.js -t 60000 test/setup.js test/10-logger.spec.js test/10-http.spec.js test/10-util.spec.js test/20-crypto-legacy.spec.js test/20-crypto-hfs.spec.js"
    },
    "repository": {
        "type": "git",
        "url": "https://github.com/publishlab/node-acme-client"
    },
    "keywords": [
        "acme",
        "client",
        "lets",
        "encrypt",
        "acmev2",
        "boulder"
    ],
    "bugs": {
        "url": "https://github.com/publishlab/node-acme-client/issues"
    }
}
